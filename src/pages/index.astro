---
/**
 * Página principal — Orquesta las secciones de la boda de Paloma & Jose
 * sobre un pliego continuo de papel de algodón (#F4F6F8) con interludios en acuarela y tinta.
 */
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/wedding/HeroSection.astro';
import WatercolorInterlude from '../components/wedding/WatercolorInterlude.astro';
import UbicacionSection from '../components/wedding/UbicacionSection.astro';
import ProgramaSection from '../components/wedding/ProgramaSection.astro';
import RSVPSection from '../components/wedding/RSVPSection.astro';
import RegalosSection from '../components/wedding/RegalosSection.astro';
import FAQSection from '../components/wedding/FAQSection.astro';
import FooterSection from '../components/wedding/FooterSection.astro';
---

<Layout
  title="Paloma & Jose · 18 Septiembre 2027"
  description="Bienvenidos a nuestra boda en Quinta Monteguerra. Paloma y Jose tienen la ilusión de invitaros a celebrar con nosotros."
>
  <HeroSection />

  <!-- Interludio 1: Rama de encina en acuarela y plumilla -->
  <WatercolorInterlude
    variant="encina"
    quote="En el viaje de la vida, lo más hermoso es el camino que trazamos juntos"
  />

  <UbicacionSection />
  <ProgramaSection />

  <!-- Interludio 2: Boceto arquitectónico del caserío manchego en azul cobalto y albero -->
  <WatercolorInterlude variant="caserio" />

  <RSVPSection />
  <RegalosSection />
  <FAQSection />

  <!-- Interludio 3: Sello botánico de cierre antes del pie de página -->
  <WatercolorInterlude variant="olivo" />

  <FooterSection />
</Layout>
