---
/**
 * RegalosSection — Nota caligráfica sobre papel de algodón para el detalle de boda.
 */
import { EVENT_CONFIG } from '../../lib/event-config';
import CopyIBANButton from './CopyIBANButton.tsx';

const { iban, titular, banco, destino } = EVENT_CONFIG.regalos;
---

<section id="regalos" class="relative py-20 sm:py-28 px-4 sm:px-6 overflow-hidden scroll-mt-20">
  <!-- Mancha de acuarela Tierra de Albero en el fondo -->
  <svg
    class="pointer-events-none absolute -left-20 bottom-10 w-80 h-80 opacity-25 pigment-multiply"
    viewBox="0 0 360 360"
    aria-hidden="true"
  >
    <ellipse cx="180" cy="180" rx="150" ry="120" fill="#DFB98C" filter="url(#watercolor-edge)" />
  </svg>

  <div class="mx-auto max-w-xl relative z-10">
    <div class="text-center mb-10">
      <p class="font-hand text-3xl text-[#3B539A] mb-1 reveal-fade">
        Un detalle con nosotros
      </p>
      <h2 class="font-serif text-3xl sm:text-4xl text-[#2B2B29] mb-4 reveal-up">
        Vuestra compañía es nuestro mayor regalo
      </h2>
      <div class="divider-ink w-28 mx-auto mb-6 reveal-line" />
      <p class="font-serif italic text-[#2B2B29]/80 text-base sm:text-lg leading-relaxed reveal-fade">
        Compartir este día con vosotros en Quinta Monteguerra es todo lo que deseamos.
        Si además queréis tener un detalle con nosotros para ayudarnos en {destino},
        os dejamos nuestra cuenta bancaria:
      </p>
    </div>

    <!-- Tarjeta artesanal IBAN con botón copiar (React island) -->
    <CopyIBANButton
      iban={iban}
      titular={titular}
      banco={banco}
      client:load
    />

    <p class="mt-6 text-center font-hand text-2xl text-[#58693B] reveal-fade">
      ¡Mil gracias de corazón!
    </p>
  </div>
</section>
