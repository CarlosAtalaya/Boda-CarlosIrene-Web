---
/**
 * ProgramaSection — El recorrido del día dibujado a mano sobre papel de algodón.
 * Un sendero sinuoso en tinta punteada conecta cada momento con manchas de acuarela
 * e iconos animados en stop-motion (boiling line).
 */
import { Heart, GlassWater, Utensils, Music, Users } from 'lucide-react';
import { EVENT_CONFIG } from '../../lib/event-config';

const { programa } = EVENT_CONFIG;

const iconMap: Record<string, typeof Heart> = {
  'Llegada': Users,
  'Ceremonia': Heart,
  'Cóctel': GlassWater,
  'Cena': Utensils,
  'Baile': Music,
};

function getIcon(desc: string) {
  for (const [key, Icon] of Object.entries(iconMap)) {
    if (desc.toLowerCase().includes(key.toLowerCase())) return Icon;
  }
  return Heart;
}

const titleMap: Record<string, string> = {
  'Llegada y bienvenida entre encinas': 'Bienvenida',
  'Ceremonia civil en los jardines': 'Ceremonia',
  'Cóctel de bienvenida en el Patio Encina': 'Cóctel',
  'Cena de celebración en el salón': 'Banquete',
  'Baile nupcial y fiesta bajo las estrellas': 'Gran Fiesta',
};

function getTitle(desc: string) {
  return titleMap[desc] ?? desc.split(' ')[0];
}

const washColors = [
  'bg-[#B8CDE3]/55 text-[#3B539A]',
  'bg-[#DFB98C]/55 text-[#B88655]',
  'bg-[#8A9A5B]/45 text-[#58693B]',
  'bg-[#B8CDE3]/55 text-[#3B539A]',
  'bg-[#DFB98C]/55 text-[#3B539A]',
] as const;

const aligns = ['right', 'left', 'right', 'left', 'right'] as const;
---

<section id="programa" class="relative py-24 sm:py-32 px-4 overflow-hidden scroll-mt-20">
  <!-- Aguada decorativa lateral en Verde Olivo suave -->
  <svg
    class="pointer-events-none absolute -right-24 top-1/3 w-96 h-96 opacity-25 pigment-multiply"
    viewBox="0 0 400 400"
    aria-hidden="true"
  >
    <ellipse cx="200" cy="200" rx="170" ry="130" fill="#8A9A5B" filter="url(#watercolor-edge)" />
  </svg>

  <div class="max-w-4xl mx-auto text-center relative z-10">
    <p class="font-hand text-2xl sm:text-3xl text-[#58693B] mb-1 reveal-fade">
      Paso a paso
    </p>
    <h2 class="font-serif text-4xl md:text-5xl mb-4 text-[#2B2B29] reveal-up">
      El Programa del Día
    </h2>
    <div class="divider-ink w-28 mx-auto mb-6 reveal-line"></div>
    <p
      class="font-serif italic text-[#2B2B29]/75 mb-20 max-w-lg mx-auto"
      style="font-size: var(--text-body-lg);"
    >
      Cada instante ha sido pensado con mimo para que disfrutéis con nosotros de principio a fin.
    </p>

    <div class="relative max-w-2xl mx-auto">
      <!-- Sendero sinuoso dibujado en tinta viva (escritorio y móvil) -->
      <svg
        class="pointer-events-none absolute left-[24px] md:left-1/2 md:-translate-x-1/2 top-4 bottom-4 w-8 h-[calc(100%-2rem)] overflow-visible"
        viewBox="0 0 32 600"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path
          d="M 16 0 C 28 100, 4 200, 18 300 C 30 400, 6 500, 16 600"
          fill="none"
          stroke="#3B539A"
          stroke-width="1.6"
          stroke-dasharray="6 8"
          stroke-linecap="round"
          stroke-opacity="0.55"
        />
      </svg>

      <!-- Hitos del programa -->
      <div class="space-y-14 sm:space-y-16">
        {programa.map((item, i) => {
          const Icon = getIcon(item.descripcion);
          const isRight = aligns[i % aligns.length] === 'right';
          const title = getTitle(item.descripcion);
          const wash = washColors[i % washColors.length];

          return (
            <div class={`relative flex items-start md:items-center w-full reveal-up ${isRight ? 'md:flex-row-reverse' : ''}`}>
              <div class="hidden md:block md:w-1/2"></div>

              <!-- Medallón de acuarela e icono con efecto boiling line -->
              <div class="absolute left-0 md:left-1/2 md:-translate-x-1/2 flex items-center justify-center w-12 h-12 z-10">
                <div class={`w-12 h-12 watercolor-mask watercolor-edge pigment-multiply ${wash}`} />
                <svg
                  class="pointer-events-none absolute inset-0 w-12 h-12 boil-line"
                  viewBox="0 0 48 48"
                  aria-hidden="true"
                >
                  <path
                    d="M 8 18 C 12 6, 36 5, 41 18 C 45 31, 36 43, 23 42 C 10 41, 4 30, 8 18 Z"
                    fill="none"
                    stroke="#2B2B29"
                    stroke-width="1.1"
                    stroke-opacity="0.55"
                  />
                </svg>
                <span class="relative z-10 text-[#2B2B29] boil-line">
                  <Icon size={19} strokeWidth={1.5} />
                </span>
              </div>

              <!-- Anotación caligráfica y detalle -->
              <div class={`w-full pl-16 md:pl-0 md:w-1/2 flex flex-col ${isRight ? 'md:pr-12 md:items-end md:text-right' : 'md:pl-12 md:items-start md:text-left'} py-1`}>
                <span class="font-hand text-3xl text-[#3B539A] leading-none mb-1">
                  {item.hora} h
                </span>
                <h3 class="font-serif text-2xl sm:text-3xl mb-1.5 text-[#2B2B29]">
                  {title}
                </h3>
                <p class="font-serif italic text-[#2B2B29]/75 text-base leading-relaxed max-w-xs">
                  {item.descripcion}
                </p>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>
