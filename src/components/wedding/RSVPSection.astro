---
/**
 * Sección RSVP — Pliego de confirmación de asistencia en acuarela y tinta viva.
 */
import RSVPForm from '../forms/RSVPForm';
---

<section class="relative px-4 sm:px-6 py-[var(--spacing-section)] pb-28 sm:pb-[var(--spacing-section)] overflow-hidden scroll-mt-20" id="rsvp">
  <!-- Mancha de aguada Azul Cielo suave en el fondo -->
  <svg
    class="pointer-events-none absolute left-1/2 -translate-x-1/2 top-12 w-[36rem] h-[36rem] opacity-25 pigment-multiply"
    viewBox="0 0 500 500"
    aria-hidden="true"
  >
    <ellipse cx="250" cy="250" rx="220" ry="180" fill="#B8CDE3" filter="url(#watercolor-edge)" />
  </svg>

  <div class="mx-auto max-w-xl relative z-10">
    <!-- Cabecera caligráfica -->
    <div class="reveal-up text-center mb-10 space-y-2">
      <p class="font-hand text-3xl text-[#3B539A]">
        ¿Nos acompañas?
      </p>
      <div class="divider-ink w-28 mx-auto reveal-line"></div>
    </div>

    <!-- Formulario React hidratado en cliente -->
    <RSVPForm client:load />
  </div>
</section>
