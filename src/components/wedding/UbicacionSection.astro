---
/**
 * UbicacionSection — Dónde & Cuándo en Quinta Monteguerra.
 * Estética de cuaderno de campo en acuarela y plumilla, sin widget meteorológico.
 */
import { MapPin, Calendar, Clock, ExternalLink } from 'lucide-react';
import { EVENT_CONFIG } from '../../lib/event-config';
import { getVenueImageUrls } from '../../lib/venue-images';
import AddToCalendarButton from '../AddToCalendarButton';
import VenueGallery from './VenueGallery';

const { lugar, lugarDireccion, coordenadas, fechaLegible, horaInicio, lugarWeb, textos } = EVENT_CONFIG;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(coordenadas)}`;
const venueImages = getVenueImageUrls();

// Formatear día de la semana y año en palabras (18 de septiembre de 2027 -> Sábado · Dos mil veintisiete)
const fechaDate = new Date(
  parseInt(EVENT_CONFIG.fecha.slice(0, 4)),
  parseInt(EVENT_CONFIG.fecha.slice(4, 6)) - 1,
  parseInt(EVENT_CONFIG.fecha.slice(6, 8))
);
const diaSemana = fechaDate.toLocaleDateString('es-ES', { weekday: 'long' });
const diaSemanaCap = diaSemana.charAt(0).toUpperCase() + diaSemana.slice(1);
const yearStr = EVENT_CONFIG.fecha.slice(0, 4);
const ANIOS_PALABRAS: Record<string, string> = {
  '2026': 'Dos mil veintiséis',
  '2027': 'Dos mil veintisiete',
  '2028': 'Dos mil veintiocho',
};
const anioPalabras = ANIOS_PALABRAS[yearStr] ?? yearStr;

// Hora legible (183000 -> 18:30)
const hora = `${horaInicio.slice(0, 2)}:${horaInicio.slice(2, 4)}`;
---

<section id="ubicacion" class="relative py-20 sm:py-28 px-6 overflow-hidden scroll-mt-20">
  <!-- Mancha atmosférica de acuarela detrás de la sección -->
  <svg
    class="pointer-events-none absolute -left-24 top-16 w-[28rem] h-[28rem] opacity-30 pigment-multiply"
    viewBox="0 0 400 400"
    aria-hidden="true"
  >
    <circle cx="200" cy="200" r="160" fill="#B8CDE3" filter="url(#watercolor-edge)" />
  </svg>

  <div class="max-w-5xl mx-auto relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-12 items-center">

      <!-- Columna izquierda: Caligrafía, datos de Quinta Monteguerra y acciones -->
      <div class="order-2 md:order-1 md:col-span-6 text-center md:text-left">
        <p class="font-hand text-2xl sm:text-3xl text-[#3B539A] mb-1 reveal-fade">
          El escenario de nuestro día
        </p>
        <h2 class="font-serif text-4xl sm:text-5xl text-[#2B2B29] mb-4 reveal-up">
          {textos.ubicacionTitulo}
        </h2>
        <div class="divider-ink w-28 mx-auto md:mx-0 mb-6 reveal-line"></div>

        <p class="font-serif italic text-lg text-[#2B2B29]/75 mb-10 leading-relaxed reveal-fade">
          {textos.ubicacionTexto}
        </p>

        <div class="space-y-7 mb-10">
          <!-- Fecha -->
          <div class="flex flex-col md:flex-row items-center md:items-start gap-4">
            <span class="flex items-center justify-center w-10 h-10 watercolor-mask bg-[#B8CDE3]/45 text-[#3B539A] boil-line">
              <Calendar size={19} strokeWidth={1.4} />
            </span>
            <div>
              <h3 class="font-serif text-2xl text-[#2B2B29]">
                {diaSemanaCap}, {fechaLegible.replace(/ de \d{4}$/, '')}
              </h3>
              <p class="font-hand text-xl text-[#58693B]">{anioPalabras}</p>
            </div>
          </div>

          <!-- Hora -->
          <div class="flex flex-col md:flex-row items-center md:items-start gap-4">
            <span class="flex items-center justify-center w-10 h-10 watercolor-mask bg-[#DFB98C]/45 text-[#B88655] boil-line">
              <Clock size={19} strokeWidth={1.4} />
            </span>
            <div>
              <h3 class="font-serif text-2xl text-[#2B2B29]">{hora} Horas</h3>
              <p class="font-serif italic text-[#2B2B29]/65 text-base">
                Recepción de invitados entre las encinas
              </p>
            </div>
          </div>

          <!-- Lugar -->
          <div class="flex flex-col md:flex-row items-center md:items-start gap-4">
            <span class="flex items-center justify-center w-10 h-10 watercolor-mask bg-[#8A9A5B]/35 text-[#58693B] boil-line">
              <MapPin size={19} strokeWidth={1.4} />
            </span>
            <div>
              <h3 class="font-serif text-2xl text-[#2B2B29]">{lugar}</h3>
              <p class="font-serif text-[#2B2B29]/70 text-base leading-relaxed">
                {lugarDireccion}
              </p>
            </div>
          </div>
        </div>

        <!-- Botones artesanales en acuarela -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start flex-wrap">
          <a
            href={mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-watercolor min-h-[46px] px-8 py-3 font-serif uppercase tracking-[0.2em] text-xs text-[#F4F6F8] touch-manipulation"
          >
            <span>Cómo llegar (Mapa)</span>
          </a>

          <a
            href={lugarWeb}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-watercolor-ghost min-h-[46px] px-7 py-3 font-serif uppercase tracking-[0.18em] text-xs inline-flex items-center justify-center gap-2 touch-manipulation"
          >
            <ExternalLink size={14} />
            <span>Conocer la Quinta</span>
          </a>

          <AddToCalendarButton />
        </div>
      </div>

      <!-- Columna derecha: Galería de Quinta Monteguerra enmarcada en acuarela y tinta -->
      <div class="order-1 md:order-2 md:col-span-6 flex items-center justify-center">
        <VenueGallery client:load images={venueImages} lugar={lugar} lugarWeb={lugarWeb} />
      </div>

    </div>
  </div>
</section>
