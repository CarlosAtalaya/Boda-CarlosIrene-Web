---
/**
 * FAQSection — Notas sobre el pliego de algodón con divisores de tinta a mano alzada.
 */
import { ChevronDown } from 'lucide-react';
import { EVENT_CONFIG } from '../../lib/event-config';

const { horaInicio, textos, novios, lugar } = EVENT_CONFIG;
const horaBienvenida = `${horaInicio.slice(0, 2)}:${horaInicio.slice(2, 4)}`;

const FAQS = [
  {
    q: '¿Existe algún protocolo de vestimenta (dress code)?',
    a: 'No pedimos una etiqueta rígida ni colores obligatorios. Lo único que deseamos es que os sintáis cómodos y elegantes para disfrutar de la tarde y la noche entre las encinas de la finca.',
  },
  {
    q: '¿A qué hora debemos llegar a Quinta Monteguerra?',
    a: `La recepción de invitados comienza a las ${horaBienvenida} h. Os recomendamos llegar con unos minutos de margen para dar un paseo tranquilo por los jardines antes de la ceremonia.`,
  },
  {
    q: '¿Cómo indicamos alergias, intolerancias o menús especiales?',
    a: 'En el tercer paso del formulario de confirmación de asistencia podréis marcar alergias o intolerancias para cada invitado (celíaco, lactosa, vegetariano, vegano, frutos secos, marisco, etc.) y añadir cualquier nota médica para cocina.',
  },
  {
    q: '¿Hasta qué fecha podemos confirmar nuestra asistencia?',
    a: `Os agradecemos que nos confirméis antes del ${textos.rsvpFechaLimite}, para poder organizar las mesas y el banquete en ${lugar} con todo el cariño.`,
  },
  {
    q: '¿Dispone la finca de aparcamiento propio?',
    a: `Sí, ${lugar} cuenta con un amplio aparcamiento privado dentro de la propia finca para todos los invitados.`,
  },
  {
    q: 'Tengo otra consulta, ¿cómo puedo hablar con vosotros?',
    a: `Al final de esta misma página encontrarás los botones directos para escribir por WhatsApp a ${novios.ella} o a ${novios.el}. ¡Estaremos encantados de ayudarte!`,
  },
];
---

<section id="faq" class="relative py-24 sm:py-32 px-6 scroll-mt-20">
  <div class="max-w-2xl mx-auto">
    <div class="text-center mb-14">
      <p class="font-hand text-3xl text-[#3B539A] mb-1 reveal-fade">
        Notas al margen
      </p>
      <h2 class="font-serif text-4xl md:text-5xl mb-4 text-[#2B2B29] reveal-up">
        Preguntas Frecuentes
      </h2>
      <div class="divider-ink w-28 mx-auto mb-6 reveal-line"></div>
      <p class="font-serif italic text-[#2B2B29]/75 max-w-lg mx-auto leading-relaxed" style="font-size: var(--text-body-lg);">
        Pequeñas respuestas para que solo tengáis que preocuparos de disfrutar.
      </p>
    </div>

    <div class="space-y-2">
      {FAQS.map((item) => (
        <details class="group transition-colors">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 px-2 font-serif text-xl sm:text-2xl text-[#2B2B29] hover:text-[#3B539A] transition-colors [&::-webkit-details-marker]:hidden">
            <span>{item.q}</span>
            <ChevronDown
              className="h-5 w-5 shrink-0 text-[#3B539A] transition-transform duration-300 group-open:rotate-180"
              strokeWidth={1.5}
            />
          </summary>
          <div class="px-2 pb-5 pt-1 font-serif text-[#2B2B29]/80 leading-relaxed text-base sm:text-lg">
            {item.a}
          </div>
          <!-- Trazo de plumilla irregular como separador de nota -->
          <svg
            viewBox="0 0 600 6"
            class="w-full h-1.5 overflow-visible pointer-events-none"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <path
              d="M 4 3 C 180 1, 410 5.5, 596 2.5"
              fill="none"
              stroke="#2B2B29"
              stroke-width="0.9"
              stroke-opacity="0.22"
              stroke-linecap="round"
            />
          </svg>
        </details>
      ))}
    </div>
  </div>
</section>
