---
/**
 * Layout Maestro — Estética Editorial Artesanal de Acuarela, Papel de Algodón y Tinta Viva.
 * Inyecta los filtros SVG globales en el DOM y envuelve el contenido en el lienzo #F4F6F8.
 */
import '../styles/global.css';
import AccessGate from '../components/AccessGate';
import Navbar from '../components/Navbar';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Paloma & Jose · 18 Septiembre 2027',
  description = 'Nos casamos en Quinta Monteguerra. Paloma y Jose tienen la ilusión de invitaros a celebrar su boda.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />

    <!-- Favicon con monograma P & J -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title}</title>
  </head>
  <body class="watercolor-canvas min-h-screen bg-[#F4F6F8] text-[#2B2B29] font-serif antialiased">
    <!-- ── FILTROS SVG GLOBALES INYECTADOS EN EL DOM ────────────────────── -->
    <svg
      class="pointer-events-none fixed top-0 left-0 h-0 w-0 overflow-hidden"
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <!-- 1) Textura física de papel de algodón prensado en frío -->
        <filter id="paper-texture" x="0%" y="0%" width="100%" height="100%">
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.04"
            numOctaves="5"
            stitchTiles="stitch"
            result="roughNoise"
          />
          <feDiffuseLighting
            in="roughNoise"
            lighting-color="#F4F6F8"
            surfaceScale="1.6"
            result="light"
          >
            <feDistantLight azimuth="45" elevation="58" />
          </feDiffuseLighting>
          <feComposite in="SourceGraphic" in2="light" operator="arithmetic" k1="1" k2="0" k3="0" k4="0" />
        </filter>

        <!-- 2) Deformación de borde sangrado de acuarela (Watercolor Edge) -->
        <filter id="watercolor-edge" x="-10%" y="-10%" width="120%" height="120%">
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.038"
            numOctaves="3"
            seed="11"
            result="waterNoise"
          />
          <feDisplacementMap
            in="SourceGraphic"
            in2="waterNoise"
            scale="11"
            xChannelSelector="R"
            yChannelSelector="G"
            result="displaced"
          />
          <feGaussianBlur in="displaced" stdDeviation="0.45" />
        </filter>

        <!-- 3) Vibración sutil de trazo dibujado a mano (Sketch Boil) -->
        <filter id="sketch-boil" x="-5%" y="-5%" width="110%" height="110%">
          <feTurbulence
            type="turbulence"
            baseFrequency="0.025"
            numOctaves="2"
            seed="4"
            result="boilNoise"
          />
          <feDisplacementMap
            in="SourceGraphic"
            in2="boilNoise"
            scale="2.2"
            xChannelSelector="R"
            yChannelSelector="G"
          />
        </filter>

        <!-- 4) Clip-path orgánico para fotografías con borde de pincelada -->
        <clipPath id="watercolor-photo-clip" clipPathUnits="objectBoundingBox">
          <path d="M0.03,0.05 C0.18,0.01 0.42,0.02 0.65,0.01 C0.82,-0.01 0.96,0.02 0.98,0.07 C1.01,0.24 0.98,0.52 0.99,0.76 C1.00,0.92 0.96,0.97 0.88,0.99 C0.68,1.01 0.35,0.98 0.12,0.99 C0.03,0.99 -0.01,0.93 0.01,0.78 C0.02,0.51 -0.01,0.22 0.03,0.05 Z" />
        </clipPath>
      </defs>
    </svg>

    <AccessGate client:load>
      <Navbar client:load />
      <main class="relative z-10">
        <slot />
      </main>
    </AccessGate>
  </body>
</html>
